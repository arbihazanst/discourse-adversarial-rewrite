# Salin ke .env, isi key, lalu muat ke terminal sesuai README.
# Script tidak membaca .env otomatis. Format: NAME=value atau NAME='value'.
# Jangan tulis komentar di belakang nilai. Gunakan petik tunggal untuk nilai
# dengan spasi atau karakter khusus. Tidak ada API key asli di template ini.

# Open WebUI: wajib untuk live run, tidak diperlukan oleh --dry-run.
OWUI_API_KEY='YOUR_API_KEY_HERE'
OWUI_BASE_URL=https://llms.si-lab.org

# PPLX: decision tool, dengan GPT-OSS sebagai orchestration model.
# Verifikasi ID lewat run_pilot_pplx.bat --list-tools / run_pilot.sh --list-tools.
PPLX_TOOL_ID=server:pplxdeciderflash
PPLX_CHAT_MODEL=google/gemma-3-27b-it
PPLX_MODEL_ID=google/gemma-3-27b-it
PPLX_URL=

# Clef/d3: Open WebUI Pipe -> container llama.cpp /v1/systemone.
# Tidak memakai endpoint Ollama localhost:11435.
CLEF_MODEL_ID=decision_spam.clef
D3_MODEL_ID=decision_spam.d3
CLEF_URL=
D3_URL=

# Wajib untuk benchmark penuh: isi revision/digest + quantization sebenarnya.
# PPLX mencakup identitas backend decision model dan orchestration model.
# Pilot koneksi 10 data mengizinkan kosong dengan status UNVERIFIED_WEIGHTS.
PPLX_CHECKPOINT_ID=''
CLEF_CHECKPOINT_ID=''
D3_CHECKPOINT_ID=''

# Hanya untuk launcher klasifikasi statis; adaptive/GAN membaca transport JSON.
TRANSPORT=openwebui
PPLX_MODE=tool
MANAGE_CONTAINERS=0

# Opsional: interpreter (kosongkan/biarkan komentar untuk default launcher).
# PYTHON=python
# EXPERIMENT_PYTHON='C:/Path/To/Python/python.exe'

# Opsional: profil launcher .sh main. Menu CLI membaca profil pilihannya sendiri.
ADAPTIVE_CONFIG=decision_models/adaptive_main.json

# Attacker Gemma terpisah dari decision model. Main default: Ollama port 30007.
# Jangan aktifkan override URL ini pada profil attacker Open WebUI (openai).
ATTACKER_URL=http://127.0.0.1:30007/api/chat
ATTACKER_MODEL=gemma3:27b
# Digest Ollama dibaca otomatis; revision manual hanya bila benar-benar diketahui.
ATTACKER_REVISION=ACTUAL_MODEL_REVISION_AND_QUANTIZATION
ATTACKER_API_KEY_ENV=OWUI_API_KEY

# Pilihan active_models tetap di JSON; .env tidak mengaktifkan Clef/d3.
# Menu CLI memakai endpoint/model/revision dari profil yang ditampilkan,
# bukan override shell di atas. OWUI_API_KEY tetap diambil dari environment.
