# Salin menjadi .env di root proyek. Script membaca .env otomatis.
# Jangan timpa .env yang sudah berisi key sendiri. Jangan commit .env.
OWUI_API_KEY='YOUR_API_KEY_HERE'

# Model, endpoint dan revision dipilih melalui menu 5 / JSON profil.
# Main mengakses localhost langsung pada host tempat kode dijalankan.
# Default PPLX 11438, Clef 11439, d3 11440, Gemma 11441.
# Experimenting meneruskan port lokal melalui SSH sesuai ssh.remote_ports.
# Revision kosong dicatat UNVERIFIED_WEIGHTS. Ganti folder hasil setelah mengganti bobot.
# OWUI_API_KEY hanya dibutuhkan jika memilih endpoint Open WebUI secara manual.

# Opsional, interpreter launcher:
# PYTHON=python
# EXPERIMENT_PYTHON='C:/Path/To/Python/python.exe'
