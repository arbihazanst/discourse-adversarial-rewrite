# Legacy direct-Python environment options; the new CLI uses its JSON profile.
# Main setup: run_cli.sh / run_cli.bat and the root .env.example.
# Do not store API keys in files you share or commit.
export TRANSPORT=direct
export PYTHON=python3
export DIRECT_HOST=127.0.0.1
# Static defaults: dataset/paper_baseline3000.csv and outputs/paper3000_baseline.
# Paths are inside the package, independent of working directory.
# export DATASET=/absolute/path/to/benchmark.csv
# export OUTPUT_DIR=/absolute/path/to/outputs/experiment_01

# Record the actual immutable revision/artifact digest AND quantization.
export CLEF_CHECKPOINT_ID=""
export D3_CHECKPOINT_ID=""
export PPLX_CHECKPOINT_ID=""

# Required for direct PPLX; fill these from the actual service's API schema.
export PPLX_NATIVE_PATH=""
export PPLX_NATIVE_TEMPLATE=""

# Alternative: local PC through Open WebUI.
# export TRANSPORT=openwebui
# export OWUI_BASE_URL=https://llms.si-lab.org
# Set OWUI_API_KEY securely in your shell.
# export CLEF_MODEL_ID=decision_spam.clef
# export D3_MODEL_ID=decision_spam.d3
# export PPLX_MODE=pipe
# export PPLX_MODEL_ID=YOUR_VERIFIED_PPLX_PIPE_ID
# Or use a verified tool (requires explicit tool provenance in the response):
# export PPLX_MODE=tool
# export PPLX_TOOL_ID=server:pplxdeciderflash
# export PPLX_CHAT_MODEL=google/gemma-3-27b-it

# The CLI uses a JSON profile. See decision_models/ADAPTIVE_README.md.
# export ADAPTIVE_CONFIG=/absolute/path/to/adaptive_main.json
# export ATTACKER_MODEL=google/gemma-3-27b-it
# Main defaults to SGLang/openai at http://127.0.0.1:30007/v1/chat/completions with no key;
# supply its verified immutable revision for a full benchmark.
# export ATTACKER_URL=http://127.0.0.1:30007/v1/chat/completions
# For an Open WebUI attacker, set its URL and credential variable in the profile:
# export ATTACKER_REVISION=ACTUAL_IMMUTABLE_MODEL_REVISION_AND_QUANTIZATION
# export ATTACKER_API_KEY_ENV=OWUI_API_KEY
# CLEF/D3/PPLX_CHECKPOINT_ID and *_MODEL_ID also override adaptive JSON fields.

# Historical container names (informational; the CLI does not manage Docker).
# Each container must have a working Docker HEALTHCHECK.
export MANAGE_CONTAINERS=0
# export CLEF_CONTAINER=decision-clef
# export D3_CONTAINER=decision-d3
# export PPLX_CONTAINER=YOUR_VERIFIED_PPLX_CONTAINER
# export MODEL_START_TIMEOUT=600
